#: inc/profile.class.php:74 inc/ticket.class.php:48

msgid "Transfer Ticket Entity"
msgstr "Transferência de Entidade do Ticket"

msgid "Change rights"
msgstr "Mudar permissões"

msgid "Using entity transfer"
msgstr "Usando transferência de entidade"

msgid "Save"
msgstr "Salvar"

msgid "Item successfully updated"
msgstr "Item atualizado com sucesso"

msgid "Error, please reload the page."
msgstr "Erro, por favor atualizar a página."

msgid ""
"If the problem persists, you can try to empty the cache by doing CTRL + F5."
msgstr ""
"Se o problema persistir, você pode tentar esvaziar o cache através das teclas CTRL + F5."

msgid "Select ticket entity to transfer"
msgstr "Select ticket entity to transfer"

msgid "Choose your entity"
msgstr "Escolha sua entidade"

msgid "Select the group to assign"
msgstr "Selecione o grupo para atribuir"

msgid "Choose your group"
msgstr "Escolha seu grupo"

msgid "Confirm transfer ?"
msgstr "Conformar transferência?"

msgid ""
"Once the transfer has been completed, the ticket will remain visible only if you have the required rights."
msgstr ""
"Uma vez que a transferência tiver sido completa, o ticket será visível somente se você tiver as permissões corretas."

msgid "Cancel"
msgstr "Cancelar"

msgid "Confirm"
msgstr "Confirmar"

msgid "Please select a valid entity"
msgstr "Por favor selecione uma entidade válida"

msgid "Please select a valid group"
msgstr "Por favor selecione um grupo válido"

msgid "Escalation to"
msgstr "Escalação para"

msgid "in the group"
msgstr "no grupo"

msgid "Successful transfer for ticket n° : "
msgstr "Transferência feita com sucesso para o ticket n° : "

msgid "Transfer canceled"
msgstr "Transferência cancelada"

msgid "Unauthorized transfer on closed ticket."
msgstr "Não é possível transferir um ticket cujo status é fechado."

msgid "Please explain your transfer"
msgstr "Por favor apresentar mais dados sobre sua transferência"

msgid "You must be assigned to the ticket to be able to transfer it"
msgstr "Você precisa estar atribuído ao ticket para ser capaz de transferi-lo"

msgid "Add myself as observer"
msgstr "Adicionar como observador"

msgid "Choose an entity"
msgstr "Escolha uma entidade"

msgid "Transfer to another entity"
msgstr "Transferir para outra entidade"

msgid "Target entity"
msgstr "Entidade de destino"

msgid "Group to assign"
msgstr "Grupo a atribuir"

msgid "No group"
msgstr "Nenhum grupo"

msgid "Transfer"
msgstr "Transferir"

msgid "You must be assigned to ticket ID %d to transfer it."
msgstr "Você deve estar atribuído ao ticket ID %d para poder transferi-lo."

msgid "Escalate to"
msgstr "Escalar para"

msgid "in group"
msgstr "no grupo"

